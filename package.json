{
  "name": "dsh-yeermu-theme",
  "version": "1.0.1",
  "type": "module",
  "description": "Yermu terminal theme for DSH: pixel window frame, holo portrait card, looping video backdrop, XP settings skin, and an optional persona card injected into the system prompt.",
  "license": "CC-BY-NC-4.0",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "assets/*",
    "README.md",
    "NOTICE.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  }
}
